generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  password            String
  firstName           String
  lastName            String
  phone               String?
  avatar              String?
  role                String         @default("CUSTOMER") // CUSTOMER | ADMIN | STAFF
  isVerified          Boolean        @default(true)
  resetPasswordToken  String?
  resetPasswordExpire DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  bookings            Booking[]
  assignedBookings    Booking[]      @relation("StaffBookings")
  reviews             Review[]
  favourites          Favourite[]
  notifications       Notification[]
}

model Destination {
  id          String    @id @default(uuid())
  name        String
  country     String
  description String
  image       String
  location    String
  category    String    // Beach, Mountain, Cultural, Adventure, Luxury, City
  rating      Float     @default(4.8)
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  packages    Package[]
  hotels      Hotel[]
}

model Package {
  id               String       @id @default(uuid())
  title            String
  destinationId    String
  destination      Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  description      String
  duration         String       // e.g. "7 Days / 6 Nights"
  durationDays     Int          @default(7)
  price            Float
  discount         Float        @default(0) // Percentage
  maxPeople        Int          @default(15)
  availableSeats   Int          @default(15)
  image            String
  gallery          String       // JSON string array
  includedServices String       // JSON string array
  excludedServices String       // JSON string array
  itinerary        String       // JSON string array of days
  status           String       @default("ACTIVE") // ACTIVE | INACTIVE | DRAFT
  featured         Boolean      @default(false)
  rating           Float        @default(4.9)
  reviewCount      Int          @default(0)
  hotelId          String?
  hotel            Hotel?       @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  vehicleId        String?
  vehicle          Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  bookings         Booking[]
  reviews          Review[]
  favourites       Favourite[]
}

model Booking {
  id                 String       @id @default(uuid())
  bookingNumber      String       @unique
  customerId         String
  customer           User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  packageId          String
  package            Package      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  staffId            String?
  staff              User?        @relation("StaffBookings", fields: [staffId], references: [id], onDelete: SetNull)
  bookingDate        DateTime     @default(now())
  travelDate         DateTime
  returnDate         DateTime?
  numberOfPeople     Int          @default(1)
  totalPrice         Float
  discountAmount     Float        @default(0)
  finalPrice         Float
  couponCode         String?
  status             String       @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED
  paymentStatus      String       @default("UNPAID")  // UNPAID | PARTIALLY_PAID | PAID | REFUNDED
  specialRequests    String?
  cancellationReason String?
  operationsNotes    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  travellers         Traveller[]
  payments           Payment[]
}

model Traveller {
  id             String    @id @default(uuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fullName       String
  email          String?
  phone          String?
  passportNumber String?
  age            Int?
  gender         String?
  isLead         Boolean   @default(false)
  createdAt      DateTime  @default(now())
}

model Payment {
  id            String    @id @default(uuid())
  bookingId     String
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount        Float
  method        String    // CARD | BANK_TRANSFER | CASH
  transactionId String    @unique
  status        String    @default("PENDING") // PENDING | SUCCESS | FAILED | REFUNDED
  receiptUrl    String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Hotel {
  id            String       @id @default(uuid())
  name          String
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  location      String
  description   String
  pricePerNight Float
  rooms         Int          @default(10)
  rating        Float        @default(4.7)
  images        String       // JSON array
  amenities     String       // JSON array
  availability  Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  packages      Package[]
}

model Vehicle {
  id             String    @id @default(uuid())
  type           String    // VAN | CAR | BUS | AIRPORT_TRANSFER
  name           String
  capacity       Int
  price          Float
  driverIncluded Boolean   @default(true)
  availability   Boolean   @default(true)
  image          String
  features       String    // JSON array
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  packages       Package[]
}

model Review {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId  String
  package    Package   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  rating     Int       // 1 - 5
  comment    String
  isApproved Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    // PERCENTAGE | FIXED
  discountValue Float
  minPurchase   Float     @default(0)
  maxDiscount   Float?
  validFrom     DateTime  @default(now())
  validUntil    DateTime
  usageLimit    Int       @default(100)
  timesUsed     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Favourite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, packageId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM") // BOOKING | PAYMENT | SYSTEM | PROMO
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}
