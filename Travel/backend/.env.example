PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase / Neon / Render)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travelsphere?schema=public"

# For instant local zero-config testing without postgres:
# DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_ACCESS_SECRET="travelsphere_super_secret_access_key_2026_xyz!"
JWT_REFRESH_SECRET="travelsphere_super_secret_refresh_key_2026_xyz!"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Frontend URL (CORS)
CLIENT_URL="http://localhost:3000"

# Cloudinary (Optional image hosting)
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY="demo"
CLOUDINARY_API_SECRET="demo"

# Email Notifications (SMTP configuration or simulation mode)
EMAIL_SERVICE="smtp"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="demo"
SMTP_PASS="demo"
EMAIL_FROM="TravelSphere Concierge <concierge@travelsphere.com>"
